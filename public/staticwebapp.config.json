{
  "routes": [
    {
      "route": "/api/records/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/photos/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/*.{html,js,css,map,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,ttf,webmanifest}"
    ]
  }
}
