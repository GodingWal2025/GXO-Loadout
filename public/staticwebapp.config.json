{
  "routes": [
    {
      "route": "/admin/bag-count-console",
      "redirect": "/bag-count-console.html",
      "statusCode": 302
    },
    {
      "route": "/api/datasets/*",
      "allowedRoles": ["admin", "vision-admin"]
    },
    {
      "route": "/api/pallet-vision/*",
      "allowedRoles": ["admin", "vision-admin"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/*.{html,js,css,map,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,ttf,webmanifest}"
    ]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(self), microphone=(), geolocation=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  }
}
